@model IAIFWebCatalog.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl shadow-lg p-8">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-gray-900">Selamat Datang</h2>
                <p class="text-gray-500 mt-2 text-sm">Masuk untuk melanjutkan ke Jelajah AI</p>
            </div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="space-y-6">
                <div asp-validation-summary="All" class="text-red-500 mb-4 text-sm"></div>
                
                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700">Email / Username</label>
                    <div class="mt-1 relative rounded-md shadow-sm">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H8m8-4H8m8 8H8m-4 0a4 4 0 014-4h8a4 4 0 014 4v1H4v-1z" />
                            </svg>
                        </span>
                        <input asp-for="Email"
                               placeholder="Masukkan email / username"
                               class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" />
                    </div>
                    <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
                </div>

                <!-- Password -->
                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700">Password</label>
                    <div class="mt-1 relative rounded-md shadow-sm">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0-1.105-.895-2-2-2s-2 .895-2 2 .895 2 2 2 2-.895 2-2zm0 0V7a5 5 0 015 5v2a5 5 0 01-5 5v-2" />
                            </svg>
                        </span>
                        <input asp-for="Password" type="password"
                               placeholder="Masukkan password"
                               class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" />
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block"></span>
                </div>

                <!-- Remember me & Forgot password -->
                <div class="flex items-center justify-between">
                    <label class="flex items-center text-sm text-gray-600">
                        <input type="checkbox" class="h-4 w-4 text-primary border-gray-300 rounded mr-2" />
                        Ingat saya
                    </label>
                    <a href="#" class="text-sm text-primary hover:text-secondary">Lupa Password?</a>
                </div>

                <!-- Button -->
                <button type="submit" class="w-full bg-primary text-white font-semibold py-3 px-4 rounded-lg hover:bg-secondary transition-colors">
                    Masuk
                </button>

                <!-- Register -->
                <p class="text-center text-sm text-gray-600">
                    Belum punya akun?
                    <a asp-controller="Account" asp-action="Register" class="text-primary hover:underline font-medium">Daftar sekarang</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
